# Copy this file to .env. Leave the secrets blank for camera preview and uploads.
PORT=8766
PUBLIC_ORIGIN=http://127.0.0.1:8766
# An absolute path is recommended on servers. Default: .amen-data in the repository.
# FITTING_DATA_DIR=/var/lib/amen-tryon

ADMIN_USER=admin
# Paste the quoted ADMIN_PASSWORD_HASH line printed by npm run admin:hash.
ADMIN_PASSWORD_HASH=

# Optional bootstrap key. You can configure keys in the admin UI instead.
DECART_API_KEY=

# Optional if ffmpeg and ffprobe are already on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# Required free space in bytes. Default: 10 GiB.
# MIN_FREE_BYTES=10737418240

# Optional credentials for a separately configured Coturn relay.
# TURN_HOST=turn.example.com
# TURN_SECRET=
